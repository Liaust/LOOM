+@pytest.mark.parametrize("route, method", [("status", "get"), ("session", "post")])
+def test_gpt_live_unknown_profile_never_reads_another_profiles_sign_in(client, hermes, openai, monkeypatch, route, method):
+    @contextlib.contextmanager
+    def scope(profile):
+        raise api.HTTPException(status_code=404, detail="Unknown profile")
+        yield
+
+    monkeypatch.setattr(sys.modules["hermes_cli.web_server_profiles"], "_config_profile_scope", scope)
+    kwargs = {"json": {"sdp": OFFER}} if method == "post" else {}
+    response = getattr(client, method)(f"{BASE}/gpt-live/{route}?profile=missing", **kwargs)
+    assert response.status_code == 404
+    assert response.headers["cache-control"] == "no-store"
+    assert hermes.refresh == [] and openai.calls == []


