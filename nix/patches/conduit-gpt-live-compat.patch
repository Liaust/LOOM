+def test_status_cannot_adopt_cli_credentials_or_write_auth_state(client, hermes, monkeypatch, openai):
+    """Native Hermes permits CLI adoption/lock writes unless read_only is set,
+    even when refresh_if_expiring is false (auth_codex #68004)."""
+    requests, mutations = [], []
+
+    def resolve(*, refresh_if_expiring=True, read_only=False):
+        requests.append((refresh_if_expiring, read_only))
+        if read_only:
+            raise AuthError("no token in this profile's own store")
+        mutations.append("adopt CLI token / write auth lock")
+        return {"api_key": GOOD_TOKEN}
+
+    monkeypatch.setattr(sys.modules["hermes_cli.auth_codex"], "resolve_codex_runtime_credentials", resolve)
+    body = client.get(f"{BASE}/gpt-live/status?profile=mina").json()
+    assert body["available"] is False
+    assert requests == [(False, True)]
+    assert mutations == [] and openai.calls == []
+    assert hermes.entered == ["mina"]
+
+
+def test_session_retains_native_refresh_in_its_selected_profile(client, hermes, monkeypatch, openai):
+    requests = []
+
+    def resolve(*, refresh_if_expiring=True, read_only=False):
+        requests.append((refresh_if_expiring, read_only, hermes.entered[-1]))
+        return {"api_key": GOOD_TOKEN}
+
+    monkeypatch.setattr(sys.modules["hermes_cli.auth_codex"], "resolve_codex_runtime_credentials", resolve)
+    response = client.post(f"{BASE}/gpt-live/session?profile=mina", json={"sdp": OFFER})
+    assert response.status_code == 200
+    assert response.json()["auth"] == "subscription"
+    assert requests == [(True, False, "mina")]
+    assert len(openai.calls) == 1
+
+
+def test_status_never_retries_a_legacy_resolver_without_read_only(client, monkeypatch, openai):
+    calls = []
+
+    def legacy_resolve(*, refresh_if_expiring=True):
+        calls.append(refresh_if_expiring)
+        return {"api_key": GOOD_TOKEN}
+
+    monkeypatch.setattr(sys.modules["hermes_cli.auth_codex"], "resolve_codex_runtime_credentials", legacy_resolve)
+    body = client.get(f"{BASE}/gpt-live/status").json()
+    assert body["available"] is False
+    assert calls == [] and openai.calls == []
+
