+def _transcribe_wake_sample(encoded: str) -> dict:
+    """Bounded local-only acoustic diagnostic; never persist the recording."""
+    import base64
+    import tempfile
+    import wave
+
+    if not isinstance(encoded, str) or not encoded or len(encoded) > 426668:
+        raise ValueError("Wake sample must contain at most ten seconds of 16 kHz PCM.")
+    try:
+        pcm = base64.b64decode(encoded, validate=True)
+    except (ValueError, TypeError) as error:
+        raise ValueError("Invalid wake sample encoding.") from error
+    if not pcm or len(pcm) > 320000 or len(pcm) % 2:
+        raise ValueError("Invalid wake sample length.")
+    from tools.transcription_tools import transcribe_audio_local_fallback
+
+    with tempfile.TemporaryDirectory(prefix="hermes-wake-sample-") as directory:
+        path = str(Path(directory) / "sample.wav")
+        with wave.open(path, "wb") as audio:
+            audio.setnchannels(1)
+            audio.setsampwidth(2)
+            audio.setframerate(16000)
+            audio.writeframes(pcm)
+        result = transcribe_audio_local_fallback(path)
+    if not result.get("success") and not result.get("no_speech"):
+        raise RuntimeError("Installed local transcription failed; no cloud fallback was used.")
+    return {"ok": True, "provider": "local", "transcript": str(result.get("transcript") or "")}
