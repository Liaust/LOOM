+class WakeTrainingRecorder {
+  constructor({ route, pause, resume, capture, save, onState, sleep = ms => new Promise(resolve => setTimeout(resolve, ms)) }) {
+    Object.assign(this, { route, pause, resume, capture, save, onState, sleep })
+    this.running = false; this.generation = 0; this.mic = null
+  }
+  cancel() {
+    if (!this.running) return
+    ++this.generation; this.mic?.stop()
+    this.onState({ phase: 'stopping', message: 'Stopping; saved samples are preserved.' })
+  }
+  async record({ kind, split, count = 10, seconds = 60 }) {
+    if (this.running) throw new Error('A training recording is already running.')
+    if (!['positive', 'negative'].includes(kind) || !['train', 'validation', 'test'].includes(split)
+      || (kind === 'positive' && (!Number.isInteger(count) || count < 1 || count > 10))
+      || (kind === 'negative' && (!Number.isFinite(seconds) || seconds <= 0 || seconds > 60))) throw new Error('Invalid recording batch.')
+    const selected = this.route()
+    if (!selected?.connectionId) throw new Error('Select MINA on Main first.')
+    const route = { ...selected }
+    this.running = true
+    const generation = ++this.generation, batchId = crypto.randomUUID().replace(/-/g, '')
+    const check = () => {
+      const current = this.route()
+      if (generation !== this.generation || current?.connectionId !== route.connectionId || current?.profile !== route.profile) throw new Error('Recording stopped; saved samples are preserved.')
+    }
+    let saved = 0, duration = 0, status = null, paused = false
+    try {
+      this.onState({ phase: 'preparing', message: 'Preparing microphone; wait for the recording cue.' })
+      await this.pause(); paused = true; check()
+      this.mic = await this.capture(error => { this.cancel(); this.onState({ phase: 'error', message: error.message }) })
+      check()
+      this.onState({ phase: 'preparing', message: 'Get ready...' })
+      await this.sleep(1500); check()
+      while (kind === 'positive' ? saved < count : duration < seconds) {
+        this.onState({ phase: 'recording', message: kind === 'positive'
+          ? `Say MINA once now (${saved + 1} of ${count})`
+          : `Speak normally without MINA (${Math.floor(duration)} of ${seconds} seconds saved)`, status })
+        const audio = await this.mic.probe(kind === 'positive' ? 3200 : 8000)
+        check()
+        this.onState({ phase: 'saving', message: 'Saving privately on Main...', status })
+        const result = await this.save(route, { target: 'mina', consent: true,
+          sampleId: crypto.randomUUID().replace(/-/g, ''), batchId, kind, split,
+          pcm: audio.pcm, microphone: audio.microphone, captureRate: audio.captureRate, dropped: audio.dropped })
+        check()
+        if (!result?.saved) throw new Error('Main did not confirm this sample; recording stopped.')
+        status = result.status; saved++; duration += audio.durationMs / 1000
+        this.onState({ phase: 'saved', message: `${saved} samples saved in this batch.`, status })
+        if (kind === 'positive' && saved < count) { await this.sleep(700); check() }
+      }
+      this.onState({ phase: 'done', message: `Batch saved: ${saved} clips.`, status })
+      return status
+    } catch (error) {
+      this.onState({ phase: 'error', message: error.message, status })
+      throw error
+    } finally {
+      this.mic?.stop(); this.mic = null; this.running = false
+      if (paused) await this.resume()
+    }
+  }
+}
