+async function openWakeRpc(route, onDetect, onLost) {
+  if (typeof sdk.resolveSiblingWsUrl !== 'function') throw new Error('This Desktop does not support routed wake connections.')
+  const url = await sdk.resolveSiblingWsUrl(route, '/api/ws')
+  const socket = new WebSocket(url)
+  const pending = new Map()
+  let nextId = 0
+  let closing = false
+  const fail = () => {
+    for (const p of pending.values()) { clearTimeout(p.timer); p.reject(new Error('Wake connection closed.')) }
+    pending.clear()
+    if (!closing) onLost(new Error('Wake connection lost; listening stopped.'))
+  }
+  socket.addEventListener('close', fail)
+  socket.addEventListener('message', event => {
+    let frame
+    try { frame = JSON.parse(event.data) } catch { return }
+    const p = pending.get(frame.id)
+    if (p) {
+      pending.delete(frame.id); clearTimeout(p.timer)
+      if (frame.error) p.reject(new Error(frame.error.message || 'Wake request failed.'))
+      else p.resolve(frame.result)
+    } else if (frame.method === 'event' && frame.params?.type === 'wake.detected') {
+      onDetect(frame.params.payload || {})
+    } else if (frame.method && frame.id != null && socket.readyState === WebSocket.OPEN) {
+      // This transport owns only wake, never approvals or agent requests.
+      socket.send(JSON.stringify({ jsonrpc: '2.0', id: frame.id, error: { code: -32601, message: 'Wake-only client' } }))
+    }
+  })
+  try {
+    await new Promise((resolve, reject) => {
+      const timer = setTimeout(() => { socket.close(); reject(new Error('Wake connection timed out.')) }, 15000)
+      socket.addEventListener('open', () => { clearTimeout(timer); resolve() }, { once: true })
+      socket.addEventListener('error', () => { clearTimeout(timer); reject(new Error('Wake connection failed.')) }, { once: true })
+    })
+  } catch (error) { closing = true; socket.close(); throw error }
+  return {
+    request(method, params = {}) {
+      if (socket.readyState !== WebSocket.OPEN) return Promise.reject(new Error('Wake connection is not open.'))
+      const id = `wake-${++nextId}`
+      return new Promise((resolve, reject) => {
+        const timer = setTimeout(() => { pending.delete(id); reject(new Error(`${method} timed out.`)) }, method === 'wake.start' ? 180000 : 10000)
+        pending.set(id, { resolve, reject, timer })
+        try { socket.send(JSON.stringify({ jsonrpc: '2.0', id, method, params })) }
+        catch (error) { pending.delete(id); clearTimeout(timer); reject(error) }
+      })
+    },
+    close() { closing = true; socket.close(); fail() }
+  }
+}
