+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { webcrypto } from 'node:crypto'
+import vm from 'node:vm'
+import { test } from 'node:test'
+
+const source = readFileSync(new URL('../desktop/plugin.js', import.meta.url), 'utf8')
+const section = source.slice(source.indexOf('class WakeTrainingRecorder'), source.indexOf('// END LOOM NATIVE WAKE'))
+const context = { crypto: webcrypto, setTimeout }
+vm.createContext(context)
+vm.runInContext(`${section}; this.Recorder = WakeTrainingRecorder`, context)
+
+function fixture(overrides = {}) {
+  const calls = [], states = [], samples = []
+  const route = { connectionId: 'main', profile: 'default' }
+  const mic = { stop() { calls.push('stop') }, async probe() {
+    return { pcm: 'private-audio', microphone: 'Actual microphone', captureRate: 48000, dropped: 0, durationMs: 3120 }
+  } }
+  const recorder = new context.Recorder({ route: () => route,
+    pause: async () => calls.push('pause'), resume: async () => calls.push('resume'),
+    capture: async () => mic, sleep: async () => {},
+    save: async (r, body) => { samples.push(body); return { saved: true, status: { count: samples.length } } },
+    onState: state => states.push(state), ...overrides })
+  return { recorder, calls, states, samples, mic, route }
+}
+
+test('one batch preserves explicit consent, split, microphone and immutable sample identities', async () => {
+  const f = fixture()
+  await f.recorder.record({ kind: 'positive', split: 'validation', count: 2 })
+  assert.deepEqual(f.calls, ['pause', 'stop', 'resume'])
+  assert.equal(f.samples.length, 2)
+  assert.equal(f.samples[0].batchId, f.samples[1].batchId)
+  assert.notEqual(f.samples[0].sampleId, f.samples[1].sampleId)
+  assert.equal(f.samples[0].consent, true)
+  assert.equal(f.samples[0].split, 'validation')
+  assert.equal(f.samples[0].microphone, 'Actual microphone')
+  assert.equal(f.recorder.running, false)
+})
+
+test('cancel stops capture and preserves previously saved clips without another upload', async () => {
+  const f = fixture()
+  let n = 0
+  f.mic.probe = async () => {
+    if (++n === 2) f.recorder.cancel()
+    return { pcm: 'private', microphone: 'Mic', captureRate: 48000, dropped: 0, durationMs: 3120 }
+  }
+  await assert.rejects(f.recorder.record({ kind: 'positive', split: 'train', count: 3 }), /stopped/)
+  assert.equal(f.samples.length, 1)
+  assert.equal(f.recorder.running, false)
+  assert.equal(f.calls.at(-1), 'resume')
+})
+
+test('route changes and unconfirmed saves end collection rather than sending another clip', async () => {
+  const f = fixture()
+  f.mic.probe = async () => { f.route.profile = 'other'; return {} }
+  await assert.rejects(f.recorder.record({ kind: 'positive', split: 'train', count: 2 }), /stopped/)
+  assert.equal(f.samples.length, 0)
+  const g = fixture({ save: async () => ({ saved: false }) })
+  await assert.rejects(g.recorder.record({ kind: 'positive', split: 'train', count: 2 }), /did not confirm/)
+  assert.equal(g.calls.at(-1), 'resume')
+})
+
+test('finishing the other quota does not prevent this kind of recording', async () => {
+  const f = fixture()
+  await f.recorder.record({ kind: 'negative', split: 'train', count: 0, seconds: 3 })
+  assert.equal(f.samples.length, 1)
+  await f.recorder.record({ kind: 'positive', split: 'train', count: 1, seconds: 0 })
+  assert.equal(f.samples.length, 2)
+})
