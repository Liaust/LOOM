+async function captureWakePcm(request, frameLength, onError, micId = '', { feed = true } = {}) {
+  const audio = { channelCount: 1, echoCancellation: true, noiseSuppression: true, autoGainControl: true }
+  if (micId) audio.deviceId = { exact: micId }
+  const stream = await navigator.mediaDevices.getUserMedia({ audio, video: false })
+  let context, source, processor, mute, stopped = false, inFlight = false, badFeeds = 0, buffered = [], lastFrame = Date.now(), watchdog
+  let probe = null, sent = 0, dropped = 0
+  const queued = []
+  const stop = () => {
+    if (stopped) return
+    stopped = true
+    queued.length = 0
+    if (probe) { clearTimeout(probe.timer); probe.reject(new Error('Microphone capture stopped during the sample.')); probe = null }
+    clearInterval(watchdog)
+    if (processor) processor.onaudioprocess = null
+    stream.getTracks().forEach(track => track.stop())
+    try { source?.disconnect(); processor?.disconnect(); mute?.disconnect() } catch {}
+    if (context) void context.close().catch(() => {})
+  }
+  const fail = error => { if (!stopped) { stop(); onError(error) } }
+  const pump = () => {
+    if (stopped || inFlight || !queued.length) return
+    const frames = queued.splice(0, 4)
+    const bytes = new Uint8Array(frames.reduce((total, frame) => total + frame.length, 0))
+    let offset = 0
+    for (const frame of frames) { bytes.set(frame, offset); offset += frame.length }
+    inFlight = true; sent += frames.length
+    void request('wake.feed', { pcm: btoa(String.fromCharCode(...bytes)), sample_rate: 16000 })
+      .then(result => {
+        if (result?.fed) badFeeds = 0
+        else if (++badFeeds >= 3) fail(new Error('Wake listener no longer accepts audio.'))
+      }, error => { if (++badFeeds >= 3) fail(error) })
+      .finally(() => { inFlight = false; pump() })
+  }
+  try {
+    if (!stream.getAudioTracks().some(track => track.readyState === 'live')) throw new Error('Wake microphone is unavailable.')
+    context = new AudioContext()
+    await context.resume()
+    source = context.createMediaStreamSource(stream)
+    processor = context.createScriptProcessor(4096, 1, 1)
+    mute = context.createGain(); mute.gain.value = 0
+    const length = Math.max(160, Math.min(16000, frameLength || 1280))
+    processor.onaudioprocess = event => {
+      if (stopped) return
+      lastFrame = Date.now()
+      const input = event.inputBuffer.getChannelData(0)
+      const ratio = context.sampleRate / 16000
+      for (let i = 0; i < Math.floor(input.length / ratio); i++) {
+        let sum = 0, count = 0
+        for (let j = Math.floor(i * ratio); j < Math.min(input.length, Math.floor((i + 1) * ratio)); j++) { sum += input[j]; count++ }
+        buffered.push(count ? sum / count : 0)
+      }
+      while (buffered.length >= length) {
+        const frame = buffered.splice(0, length)
+        const bytes = new Uint8Array(length * 2), view = new DataView(bytes.buffer)
+        frame.forEach((value, index) => { const s = Math.max(-1, Math.min(1, value)); view.setInt16(index * 2, s < 0 ? s * 32768 : s * 32767, true) })
+        if (probe && probe.samples + length <= 160000) {
+          probe.chunks.push(bytes)
+          for (const value of frame) { probe.squareSum += value * value; probe.peak = Math.max(probe.peak, Math.abs(value)) }
+          probe.samples += length
+        }
+        if (feed) {
+          queued.push(bytes)
+          if (queued.length > 6) { queued.shift(); dropped++ } // At most 480 ms queued, never an unbounded delay.
+        }
+      }
+      pump() // One ordered RPC at a time; batch bursts from the same audio callback.
+    }
+    stream.getAudioTracks().forEach(track => track.addEventListener('ended', () => fail(new Error('Wake microphone stopped.')), { once: true }))
+    source.connect(processor); processor.connect(mute); mute.connect(context.destination)
+    watchdog = setInterval(() => { if (Date.now() - lastFrame > 5000) fail(new Error('Wake microphone stopped delivering audio.')) }, 2500)
+    return {
+      stop,
+      probe(durationMs = 8000) {
+        if (stopped || probe) return Promise.reject(new Error('Wake sample is unavailable or already recording.'))
+        if (!Number.isFinite(durationMs) || durationMs < 2600 || durationMs > 10000) return Promise.reject(new Error('Invalid recording duration.'))
+        return new Promise((resolve, reject) => {
+          probe = { chunks: [], samples: 0, squareSum: 0, peak: 0, sent, dropped, reject, timer: null }
+          probe.timer = setTimeout(() => {
+            const sample = probe; probe = null
+            const bytes = new Uint8Array(sample.samples * 2)
+            let offset = 0
+            for (const chunk of sample.chunks) { bytes.set(chunk, offset); offset += chunk.length }
+            let binary = ''
+            for (let i = 0; i < bytes.length; i += 4096) binary += String.fromCharCode(...bytes.subarray(i, i + 4096))
+            resolve({ pcm: btoa(binary), durationMs: sample.samples / 16,
+              microphone: stream.getAudioTracks()[0]?.label || 'System default',
+              captureRate: context.sampleRate,
+              sent: sent - sample.sent, dropped: dropped - sample.dropped,
+              rms: Math.sqrt(sample.squareSum / Math.max(1, sample.samples)), peak: sample.peak })
+          }, durationMs)
+        })
+      }
+    }
+  } catch (error) { stop(); throw error }
+}
