+def _wake_training_status(profile: str) -> dict:
+    root = _wake_training_root(profile)
+    counts = {split: {"positive": 0, "negativeSeconds": 0.0}
+              for split in ("train", "validation", "test")}
+    invalid = 0
+    if root.exists():
+        if root.is_symlink():
+            raise ValueError("Training directory must not be a symbolic link.")
+        for path in root.glob("*/sample.json"):
+            if path.parent.name.startswith("."):
+                continue
+            try:
+                record = json.loads(path.read_text())
+                if record["schema"] != 1 or record["target"] != "mina":
+                    raise ValueError("Unknown training sample schema.")
+                group = counts[record["split"]]
+                if not (path.parent / "audio.wav").is_file():
+                    raise ValueError("Incomplete training sample.")
+                if record["kind"] == "positive":
+                    group["positive"] += 1
+                elif record["kind"] == "negative":
+                    group["negativeSeconds"] += record["seconds"]
+                else:
+                    raise ValueError("Unknown sample class.")
+            except (KeyError, TypeError, ValueError, OSError):
+                invalid += 1
+    return {"ok": True, "target": "mina", "counts": counts, "invalid": invalid,
+            "goals": {"train": {"positive": 60, "negativeSeconds": 120},
+                      "validation": {"positive": 20, "negativeSeconds": 60},
+                      "test": {"positive": 20, "negativeSeconds": 60}}}
+
