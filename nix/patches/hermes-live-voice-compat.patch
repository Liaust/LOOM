+++ b/tests/test_loom_wake.mjs
@@ -0,0 +1,202 @@
+import assert from 'node:assert/strict'
+import { readFileSync } from 'node:fs'
+import { test } from 'node:test'
+import vm from 'node:vm'
+
+const source = readFileSync(new URL('../desktop/plugin.js', import.meta.url), 'utf8')
+const section = source.slice(source.indexOf("const KEY_WAKE ="), source.indexOf('// END LOOM NATIVE WAKE'))
+const context = { setTimeout, clearTimeout, setInterval, clearInterval, sdk: {} }
+vm.createContext(context)
+vm.runInContext(`${section}\nthis.Client = NativeWakeClient; this.openRpc = openWakeRpc; this.capture = captureWakePcm`, context)
+
+const defer = () => { let resolve; const promise = new Promise(r => { resolve = r }); return { promise, resolve } }
+function fixture(overrides = {}) {
+  const calls = [], states = [], microphones = []
+  const config = { enabled: true, configured_surface: 'live-voice', owned_by_caller: true, frame_length: 1280 }
+  const rpc = {
+    async request(method, params) {
+      calls.push([method, params])
+      if (method === 'wake.status') return { ...config }
+      if (method === 'wake.start') return { started: true, capture: 'client', frame_length: 1280 }
+      if (method === 'wake.resume') return { resumed: true }
+      return {}
+    },
+    close() { calls.push(['close']) }
+  }
+  const client = new context.Client({
+    connect: async () => rpc,
+    capture: async () => { const mic = { stopped: false, stop() { this.stopped = true } }; microphones.push(mic); return mic },
+    onState: state => states.push(state), onDetect: () => {}, ...overrides
+  })
+  client.setRoute({ connectionId: 'main', profile: 'default' })
+  return { client, calls, states, microphones, config, rpc }
+}
+
+test('wake stops the listening mic before starting one call, then re-arms after hang-up', async () => {
+  const f = fixture()
+  let detected = 0
+  f.client.onDetect = () => { assert.equal(f.microphones[0].stopped, true); detected++ }
+  await f.client.enable()
+  assert.equal(f.client.phase, 'listening')
+  f.client.detected({}); f.client.detected({})
+  assert.equal(detected, 1)
+  await f.client.pauseForCall()
+  await f.client.resumeAfterCall()
+  assert.equal(f.client.phase, 'listening')
+  assert.equal(f.microphones.length, 2)
+  f.client.dispose()
+})
+
+test('a deliberate off during microphone acquisition wins', async () => {
+  const pending = defer()
+  const mic = { stopped: false, stop() { this.stopped = true } }
+  const f = fixture({ capture: () => pending.promise })
+  const arming = f.client.enable()
+  await new Promise(resolve => setImmediate(resolve))
+  await f.client.disable()
+  pending.resolve(mic); await arming
+  assert.equal(mic.stopped, true)
+  assert.equal(f.client.phase, 'off')
+  assert.equal(f.client.wanted, false)
+  assert.equal(f.calls.some(([m, p]) => m === 'wake.stop' && p.persist), true)
+})
+
+test('off during connection establishment closes the stale connection without capture', async () => {
+  const pending = defer()
+  const f = fixture({ connect: () => pending.promise })
+  const arming = f.client.enable()
+  await f.client.disable()
+  pending.resolve(f.rpc); await arming
+  assert.equal(f.microphones.length, 0)
+  assert.equal(f.calls.at(-1)[0], 'close')
+})
+
+test('native config off prevents resume and is not overwritten', async () => {
+  const f = fixture()
+  await f.client.enable(); await f.client.pauseForCall()
+  f.config.enabled = false
+  await f.client.resumeAfterCall()
+  assert.equal(f.client.phase, 'off')
+  assert.equal(f.microphones.length, 1)
+  assert.equal(f.calls.some(([m]) => m === 'wake.resume'), false)
+  f.client.dispose()
+})
+
+test('the listening label follows the configured keyword rather than a hard-coded greeting', async () => {
+  const f = fixture()
+  f.config.phrase = 'mina'
+  await f.client.enable()
+  assert.equal(f.states.at(-1).phrase, 'mina')
+  await f.client.disable()
+  f.config.phrase = 'different phrase'
+  await f.client.enable()
+  assert.equal(f.states.at(-1).phrase, 'different phrase')
+  f.client.dispose()
+})
+
+test('another owner is not stolen; the wrong surface never opens a mic', async () => {
+  const f = fixture()
+  f.config.configured_surface = 'gui'
+  await assert.rejects(f.client.enable(), /live-voice surface/)
+  assert.equal(f.microphones.length, 0)
+  f.client.dispose()
+  const g = fixture()
+  await g.client.enable(); await g.client.pauseForCall()
+  g.config.owned_by_caller = false
+  await g.client.resumeAfterCall()
+  assert.equal(g.client.phase, 'error')
+  assert.equal(g.microphones.length, 1)
+  assert.equal(g.calls.some(([m]) => m === 'wake.resume'), false)
+})
+
+test('unchanged owner does not restart capture; route change and loss release it', async () => {
+  const f = fixture()
+  await f.client.enable()
+  assert.equal(f.client.setRoute({ connectionId: 'main', profile: 'default' }), false)
+  assert.equal(f.microphones[0].stopped, false)
+  f.client.setRoute({ connectionId: 'main', profile: 'reader' })
+  assert.equal(f.microphones[0].stopped, true)
+  await f.client.enable()
+  f.client.lost(new Error('offline'))
+  assert.equal(f.microphones[1].stopped, true)
+  assert.equal(f.client.phase, 'error')
+})
+
+test('diagnostic counts wake matches without starting calls or a second microphone', async () => {
+  const f = fixture(), pending = defer()
+  let calls = 0
+  f.client.onDetect = () => { calls++ }
+  await f.client.enable()
+  f.microphones[0].probe = () => pending.promise
+  const sample = f.client.sample()
+  f.client.detected({}); f.client.detected({})
+  await assert.rejects(f.client.pauseForCall(), /Finish the eight-second/)
+  assert.equal(f.microphones[0].stopped, false)
+  assert.equal(f.calls.filter(([method]) => method === 'wake.resume').length, 2)
+  pending.resolve({ pcm: 'sample', dropped: 0 })
+  assert.equal((await sample).matches, 2)
+  assert.equal(f.client.probing, false)
+  assert.equal(f.microphones[0].stopped, true)
+  assert.equal(f.client.phase, 'listening')
+  assert.equal(calls, 0)
+  f.client.dispose()
+})
+
+test('one audio callback sends all burst frames, with later frames ordered behind the acknowledgement', async () => {
+  const requests = [], completions = []
+  const node = () => ({ connect() {}, disconnect() {} })
+  const track = { readyState: 'live', label: 'Test mic', addEventListener() {}, stop() {} }
+  context.navigator = { mediaDevices: { getUserMedia: async () => ({ getTracks: () => [track], getAudioTracks: () => [track] }) } }
+  context.AudioContext = class {
+    constructor() { this.sampleRate = 16000; this.destination = {}; context.audioContext = this }
+    async resume() {}
+    async close() {}
+    createMediaStreamSource() { return node() }
+    createScriptProcessor() { this.processor = node(); return this.processor }
+    createGain() { return { ...node(), gain: { value: 0 } } }
+  }
+  context.btoa = binary => Buffer.from(binary, 'binary').toString('base64')
+  const handle = await context.capture((method, params) => {
+    requests.push(Buffer.from(params.pcm, 'base64'))
+    const pending = defer(); completions.push(pending); return pending.promise
+  }, 1280, error => { throw error })
+  const emit = value => context.audioContext.processor.onaudioprocess({ inputBuffer: { getChannelData: () => new Float32Array(3840).fill(value) } })
+  emit(0.25)
+  assert.equal(requests.length, 1)
+  assert.equal(requests[0].length, 3 * 1280 * 2)
+  emit(0.5)
+  assert.equal(requests.length, 1)
+  completions[0].resolve({ fed: true })
+  await new Promise(resolve => setImmediate(resolve))
+  assert.equal(requests.length, 2)
+  assert.equal(requests[1].length, 3 * 1280 * 2)
+  assert.equal(requests[0].readInt16LE(0), 8191)
+  assert.equal(requests[1].readInt16LE(0), 16383)
+  handle.stop(); completions[1].resolve({ fed: true })
+})
+
+test('wake uses the routed native socket, not the main Desktop event stream', async () => {
+  class Socket extends EventTarget {
+    static OPEN = 1
+    constructor(url) { super(); this.url = url; this.readyState = 1; Socket.current = this; queueMicrotask(() => this.dispatchEvent(new Event('open'))) }
+    send(text) { this.sent = JSON.parse(text) }
+    close() { this.readyState = 3; this.dispatchEvent(new Event('close')) }
+    receive(frame) { const event = new Event('message'); event.data = JSON.stringify(frame); this.dispatchEvent(event) }
+  }
+  context.WebSocket = Socket
+  let routeSeen, wakes = 0, losses = 0
+  context.sdk.resolveSiblingWsUrl = async (route, path) => { routeSeen = { ...route, path }; return 'wss://main.invalid/api/ws?ticket=private' }
+  const rpc = await context.openRpc({ connectionId: 'main', profile: 'default' }, () => wakes++, () => losses++)
+  assert.equal(routeSeen.connectionId, 'main')
+  assert.equal(routeSeen.path, '/api/ws')
+  const result = rpc.request('wake.status', { surface: 'live-voice' })
+  const socket = Socket.current
+  socket.receive({ jsonrpc: '2.0', id: socket.sent.id, result: { enabled: false } })
+  assert.equal((await result).enabled, false)
+  socket.receive({ jsonrpc: '2.0', method: 'event', params: { type: 'wake.detected', payload: {} } })
+  assert.equal(wakes, 1)
+  const pending = rpc.request('wake.status')
+  rpc.close()
+  await assert.rejects(pending, /closed/)
+  assert.equal(losses, 0)
+})
