+class NativeWakeClient {
+  constructor({ connect, capture, onState, onDetect }) {
+    Object.assign(this, { connect, capture, onState, onDetect })
+    this.route = null; this.rpc = null; this.mic = null; this.wanted = false; this.generation = 0; this.phase = 'off'; this.phrase = 'mina'
+  }
+  state(phase, error = '') { this.phase = phase; this.onState({ phase, error, enabled: this.wanted, phrase: this.phrase }) }
+  stopMic() { this.mic?.stop(); this.mic = null }
+  lost(error) { this.generation++; this.stopMic(); this.rpc?.close(); this.rpc = null; this.state('error', error.message) }
+  setRoute(route) {
+    const key = value => value ? `${value.connectionId}:${value.profile}` : ''
+    if (key(route) === key(this.route)) return false
+    this.dispose(); this.route = route; return true
+  }
+  async enable(persist = true) {
+    if (!this.route) throw new Error('Select MINA on Main before enabling wake.')
+    this.wanted = true
+    const generation = ++this.generation
+    this.state('arming')
+    try {
+      let connected = this.rpc
+      const rpc = connected || await this.connect(this.route,
+        payload => { if (this.rpc === connected) this.detected(payload) },
+        error => { if (this.rpc === connected) this.lost(error) })
+      connected = rpc
+      if (generation !== this.generation) { if (rpc !== this.rpc) rpc.close(); return }
+      this.rpc = rpc
+      const status = await rpc.request('wake.status', { surface: WAKE_SURFACE, client_capture: true })
+      if (generation !== this.generation) return
+      this.phrase = String(status.phrase || this.phrase)
+      if (status.configured_surface !== WAKE_SURFACE) throw new Error('Native wake must be assigned to the live-voice surface.')
+      if (!persist && !status.enabled) { this.wanted = false; this.state('off'); return }
+      const result = await rpc.request('wake.start', { surface: WAKE_SURFACE, client_capture: true, persist })
+      if (generation !== this.generation) {
+        if (!this.wanted) { try { await rpc.request('wake.stop', { persist: true }) } catch {} }
