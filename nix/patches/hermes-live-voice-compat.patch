+++ b/tests/test_loom_compat.py
@@ -0,0 +1,132 @@
+"""Focused LOOM custom-home and subscription-only regressions."""
+
+import asyncio
+import re
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from test_plugin_api import PLUGIN_API, load_unit
+
+
+def test_default_and_named_profiles_use_native_root(tmp_path):
+    root = tmp_path / "custom-hermes"
+    reader = root / "profiles" / "reader"
+    reader.mkdir(parents=True)
+    (reader / "SOUL.md").write_text("# Reader\n")
+    resolve = lambda name: root if name == "default" else root / "profiles" / name
+    ns = load_unit(PLUGIN_API, "_profile_home")
+    ns.update(re=re, _profile_path=resolve)
+    assert ns["_profile_home"]("default") == root.resolve()
+    assert ns["_profile_home"]("reader") == reader.resolve()
+    assert ns["_profile_home"]("missing") is None
+    assert ns["_profile_home"]("../reader") is None
+    bots = load_unit(PLUGIN_API, "_list_bots")
+    bots.update(_profile_path=resolve)
+    assert bots["_list_bots"]() == ["reader"]
+
+
+def test_host_name_uses_default_personality_when_agent_name_is_unset(tmp_path):
+    (tmp_path / "config.yaml").write_text("model:\n  default: example\n")
+    ns = load_unit(PLUGIN_API, "_host_bot_name")
+    ns.update(talk_config=SimpleNamespace(get_hermes_home=lambda: tmp_path),
+              _bot_display_name=lambda profile: "MINA")
+    assert ns["_host_bot_name"]() == "MINA"
+
+
+@pytest.mark.parametrize("name,code,guard", [
+    ("create_session", 403, "_subscription_only"),
+    ("codex_login_start", 409, "_managed_auth"),
+    ("codex_login_cancel", 409, "_managed_auth"),
+])
+def test_managed_mode_refuses_before_credentials_or_network(name, code, guard):
+    class Refused(Exception):
+        def __init__(self, status_code, detail):
+            self.status_code = status_code
+
+    ns = load_unit(PLUGIN_API, name)
+    ns.update({guard: lambda: True, "HTTPException": Refused})
+    with pytest.raises(Refused) as error:
+        asyncio.run(ns[name](SimpleNamespace()) if name == "create_session" else ns[name]())
+    assert error.value.status_code == code
+
+
+def test_desktop_has_no_quota_fallback():
+    source = (PLUGIN_API.parent.parent / "desktop/plugin.js").read_text()
+    assert "ctx.storage.set(KEY_ENGINE, 'realtime')" not in source
+    assert "value: 'hermes', children: opt" not in source
+    assert "if (eng !== 'codex') throw new Error" in source
+
+
+@pytest.mark.parametrize("encoded", [None, "", "!", "AA==", "A" * 426669])
+def test_wake_sample_rejects_invalid_or_oversized_pcm_before_transcription(encoded):
+    ns = load_unit(PLUGIN_API, "_transcribe_wake_sample")
+    ns["Path"] = Path
+    with pytest.raises(ValueError):
+        ns["_transcribe_wake_sample"](encoded)
+
+
+def test_wake_sample_uses_local_only_and_removes_its_temporary_wav(monkeypatch):
+    import base64
+    import sys
+    import wave
+
+    paths = []
+    def local_only(path):
+        paths.append(Path(path))
+        with wave.open(path) as audio:
+            assert (audio.getnchannels(), audio.getsampwidth(), audio.getframerate()) == (1, 2, 16000)
+            assert audio.readframes(2) == b"\x01\x00\x02\x00"
+        return {"success": True, "transcript": "Hey Mina", "provider": "local"}
+
+    monkeypatch.setitem(sys.modules, "tools.transcription_tools", SimpleNamespace(transcribe_audio_local_fallback=local_only))
+    ns = load_unit(PLUGIN_API, "_transcribe_wake_sample")
+    ns["Path"] = Path
+    result = ns["_transcribe_wake_sample"](base64.b64encode(b"\x01\x00\x02\x00").decode())
+    assert result == {"ok": True, "provider": "local", "transcript": "Hey Mina"}
+    assert len(paths) == 1 and not paths[0].exists() and not paths[0].parent.exists()
+
+
+def training_unit(tmp_path):
+    import os
+    import sys
+    import threading
+    ns = load_unit(PLUGIN_API, "_save_wake_training_sample")
+    ns.update(Path=Path, re=re, json=__import__("json"), os=os, sys=sys,
+              _TRAINING_LOCK=threading.Lock(), _wake_training_root=lambda _: tmp_path / "training")
+    status = load_unit(PLUGIN_API, "_wake_training_status")
+    status.update(json=__import__("json"), _wake_training_root=ns["_wake_training_root"])
+    ns["_wake_training_status"] = status["_wake_training_status"]
+    return ns
+
+
+def test_training_saved_privately_and_replayed_without_duplicate(tmp_path):
+    import base64
+    import math
+    import struct
+    import wave
+    ns = training_unit(tmp_path)
+    pcm = b"".join(struct.pack("<h", int(3000 * math.sin(i / 7))) for i in range(48000))
+    body = {"consent": True, "target": "mina", "sampleId": "a" * 32, "batchId": "b" * 32,
+            "kind": "positive", "split": "validation", "microphone": "Test microphone",
+            "captureRate": 48000, "dropped": 0, "pcm": base64.b64encode(pcm).decode()}
+    first = ns["_save_wake_training_sample"]("default", body)
+    second = ns["_save_wake_training_sample"]("default", body)
+    assert first["status"]["counts"]["validation"]["positive"] == 1
+    assert second["status"]["counts"]["validation"]["positive"] == 1
+    root = tmp_path / "training"
+    assert root.stat().st_mode & 0o777 == 0o700
+    assert (root / body["sampleId"] / "audio.wav").stat().st_mode & 0o777 == 0o600
+    with wave.open(str(root / body["sampleId"] / "audio.wav")) as audio:
+        assert audio.getframerate() == 16000 and audio.readframes(48000) == pcm
+    body["split"] = "train"
+    with pytest.raises(ValueError, match="different data"):
+        ns["_save_wake_training_sample"]("default", body)
+
+
+def test_training_requires_opt_in_and_lossless_audio(tmp_path):
+    ns = training_unit(tmp_path)
+    with pytest.raises(ValueError, match="consent"):
+        ns["_save_wake_training_sample"]("default", {})
+    assert not (tmp_path / "training").exists()
