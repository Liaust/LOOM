+def _save_wake_training_sample(profile: str, body: dict) -> dict:
+    """Explicit collection only. Commit one immutable WAV and its metadata together."""
+    import array
+    import base64
+    import hashlib
+    import math
+    import tempfile
+    import wave
+
+    if body.get("consent") is not True or body.get("target") != "mina":
+        raise ValueError("Explicit MINA training recording consent is required.")
+    sample_id, batch_id = body.get("sampleId"), body.get("batchId")
+    if not all(isinstance(value, str) and re.fullmatch(r"[a-f0-9]{32}", value)
+               for value in (sample_id, batch_id)):
+        raise ValueError("Invalid training sample or batch identity.")
+    kind, split = body.get("kind"), body.get("split")
+    if kind not in ("positive", "negative") or split not in ("train", "validation", "test"):
+        raise ValueError("Invalid training class or split.")
+    encoded = body.get("pcm")
+    if not isinstance(encoded, str) or not encoded or len(encoded) > 426668:
+        raise ValueError("Training clips must be at most ten seconds.")
+    try:
+        pcm = base64.b64decode(encoded, validate=True)
+    except (ValueError, TypeError) as error:
+        raise ValueError("Invalid training PCM encoding.") from error
+    seconds = len(pcm) / 32000
+    if len(pcm) % 2 or not 2.5 <= seconds <= 10:
+        raise ValueError("Invalid training PCM duration.")
+    if kind == "positive" and seconds > 4:
+        raise ValueError("Positive clips must contain one short utterance.")
+    if type(body.get("dropped")) is not int or body["dropped"] != 0:
+        raise ValueError("Audio frames were dropped; record this clip again.")
+    microphone, capture_rate = body.get("microphone"), body.get("captureRate")
+    if not isinstance(microphone, str) or not 1 <= len(microphone) <= 250:
+        raise ValueError("Missing actual training microphone.")
+    if type(capture_rate) is not int or not 8000 <= capture_rate <= 192000:
+        raise ValueError("Invalid microphone capture rate.")
+    samples = array.array("h", pcm)
+    if sys.byteorder != "little":
+        samples.byteswap()
+    rms = math.sqrt(sum(value * value for value in samples) / len(samples)) / 32768
+    if kind == "positive" and rms < 0.001:
+        raise ValueError("This clip is too quiet; please record that utterance again.")
+    record = {"schema": 1, "target": "mina", "sampleId": sample_id,
+              "batchId": batch_id, "kind": kind, "split": split,
+              "microphone": microphone, "captureRate": capture_rate,
+              "sampleRate": 16000, "seconds": seconds, "dropped": 0,
+              "rms": rms, "peak": max(abs(value) for value in samples) / 32768,
+              "pcmSha256": hashlib.sha256(pcm).hexdigest()}
+    root = _wake_training_root(profile)
+    with _TRAINING_LOCK:
+        root.mkdir(mode=0o700, parents=True, exist_ok=True)
+        if root.is_symlink():
+            raise ValueError("Training directory must not be a symbolic link.")
+        root.chmod(0o700)
+        destination = root / sample_id
+        if destination.exists():
+            previous = json.loads((destination / "sample.json").read_text())
+            if any(previous.get(key) != value for key, value in record.items()):
+                raise ValueError("Training sample identity already contains different data.")
+        else:
+            with tempfile.TemporaryDirectory(prefix=".pending-", dir=root) as directory:
+                temporary = Path(directory)
+                path = temporary / "audio.wav"
+                with path.open("xb") as raw:
+                    path.chmod(0o600)
+                    with wave.open(raw, "wb") as audio:
+                        audio.setnchannels(1)
+                        audio.setsampwidth(2)
+                        audio.setframerate(16000)
+                        audio.writeframes(pcm)
+                    raw.flush()
+                    os.fsync(raw.fileno())
+                record["createdAt"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
+                metadata = temporary / "sample.json"
+                with metadata.open("x") as output:
+                    metadata.chmod(0o600)
+                    json.dump(record, output, sort_keys=True)
+                    output.flush()
+                    os.fsync(output.fileno())
+                temporary.rename(destination)
+                directory_fd = os.open(root, os.O_RDONLY)
+                try:
+                    os.fsync(directory_fd)
+                finally:
+                    os.close(directory_fd)
+    return {"ok": True, "saved": True, "sampleId": sample_id,
+            "status": _wake_training_status(profile)}
+
