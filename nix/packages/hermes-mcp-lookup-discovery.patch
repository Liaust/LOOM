+def ensure_mcp_discovery_for_tool_lookup(*, enabled_toolsets=None, disabled_toolsets=None) -> None:
+    """Recover missing MCP registrations when the agent actually requests its catalogue.
+
+    Startup is deliberately deferred and bounded; a failed/slow first pass must not
+    leave an existing conversation permanently tool-less. Reuse its profile-scoped
+    discovery owner, not a standalone probe or an unbounded reconnect worker.
+    """
+    from tools.mcp_tool_discovery import get_mcp_status
+    import logging
+
+    enabled = None if enabled_toolsets is None else set(enabled_toolsets)
+    disabled = set(disabled_toolsets or [])
+    names = []
+    for entry in get_mcp_status() or []:
+        name = entry["name"]
+        aliases = {name, "mcp-" + name}
+        if (not entry.get("enabled", True) or entry.get("status") == "disabled"
+                or aliases & disabled or (enabled is not None and not aliases & enabled)
+                or (_mcp_server_filter is not None and name not in _mcp_server_filter)):
+            continue
+        if (entry.get("connected") or entry.get("status") == "lazy") and entry.get("tools", 0):
+            continue
+        names.append(name)
+    if not names:
+        return
+    start_background_mcp_discovery(logger=logging.getLogger(__name__),
+                                   thread_name="mcp-tool-lookup", allowed_mcp_names=names)
+    # Explicit lookups, unlike startup hydration, need a usable answer on this call.
+    # Join only this profile's thread; never fire an unrelated deferred startup here.
+    join_mcp_discovery(timeout=_resolve_discovery_timeout(None, single_query=True))
+
+
