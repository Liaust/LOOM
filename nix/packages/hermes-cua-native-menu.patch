+    def invoke_menu(self, path) -> ActionResult:
+        refusal, args = self._target_args("invoke_menu", need_window=True)
+        if refusal is not None:
+            return refusal
+        if not isinstance(path, list) or not 1 <= len(path) <= 16 or any(
+                not isinstance(label, str) or not label.strip() or len(label) > 200 for label in path):
+            return _refuse("invoke_menu", "Use one to sixteen non-empty native menu labels.")
+        if not self._session._has_tool("invoke_menu"):
+            return _refuse("invoke_menu", "This driver does not support native menu invocation.")
+        return self._action("invoke_menu", {**args, "path": path})
