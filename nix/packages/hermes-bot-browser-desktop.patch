+def socket_temp_env(env: dict) -> dict[str, str]:
+    """Only shorten browser temp roots, never its persistent profile or Hermes scratch policy."""
+    from hermes_constants import SOCKET_TMPDIR_MAX_LEN, socket_safe_tmpdir
+
+    keys = ("TMPDIR", "TMP", "TEMP")
+    if not any(len(os.fsencode(env.get(key, ""))) > SOCKET_TMPDIR_MAX_LEN for key in keys):
+        return {}
+    root = socket_safe_tmpdir()
+    # The upstream helper counts characters; AF_UNIX limits encoded bytes.
+    if len(os.fsencode(root)) > SOCKET_TMPDIR_MAX_LEN:
+        root = "/tmp"
+    return {key: root for key in keys}
+
