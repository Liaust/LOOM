+def _nix_external_install() -> bool:
+    from pm.paths import install_stamp_path
+
+    try:
+        stamp = json.loads(install_stamp_path(paths.repo_root()).read_text(encoding="utf-8-sig"))
+    except FileNotFoundError:
+        return False
+    except (OSError, ValueError) as exc:
+        raise InstallError("nix-plugin-selection", "cannot read the package install stamp",
+                           "repair the Hermes package through its installation manager") from exc
+    if not isinstance(stamp, dict):
+        raise InstallError("nix-plugin-selection", "invalid package install stamp",
+                           "repair the Hermes package through its installation manager")
+    return stamp.get("distribution") == "nix" and stamp.get("updateMechanism") == "external"
+
+
+def _publish_nix_selection(change, selection: dict, extras) -> None:
+    """Nix owns Python; only a dependency-free selection may publish here."""
+    from pm.plugin_declarations import read_python_declaration, unsupported_requirements
+    from pm.publication import validate_manifest
+    from pm.workspace import enabled_plugin_dirs
+
+    remedy = "Declare Python dependencies in the Nix package and rebuild through its owning manager, then retry."
+    if extras:
+        raise InstallError("nix-plugin-selection", "Nix owns the Python environment; cannot add extras", remedy)
+    selected = enabled_plugin_dirs(proposed_home=change.home, enabled=selection["enabled"],
+                                   disabled=selection["disabled"])
+    selected.extend(Path(directory) for directory in selection.get("extra_dirs", ()))
+    for source in dict.fromkeys(selected):
+        validate_manifest(source)
+        declaration = read_python_declaration(source)
+        if not declaration.external and (declaration.is_member or unsupported_requirements(declaration.requirements)):
+            raise InstallError("nix-plugin-selection",
+                               f"Plugin '{source.name}' declares Python dependencies or packaging; Nix owns the environment",
+                               remedy)
+    _publish_inactive(change, reason="Nix-managed dependency-free plugin selection")
 
 
