diff --git a/hermes_cli/profile_context.py b/hermes_cli/profile_context.py
--- /dev/null
+++ b/hermes_cli/profile_context.py
@@ -0,0 +1,107 @@
+"""Explicit per-invocation context; no process-global environment switches."""
+from pathlib import Path
+
+
+def policy(home=None):
+    from hermes_constants import get_hermes_home
+    from utils import load_yaml_file_readonly
+    directory = Path(home or get_hermes_home())
+    bound = (directory / "loom-box-owner.json").exists()
+    path = directory / "config.yaml"
+    if not path.exists():
+        if bound:
+            raise ValueError("bound profile configuration unavailable")
+        return {}
+    config = load_yaml_file_readonly(path)
+    if not isinstance(config, dict):
+        raise ValueError("profile configuration unavailable")
+    value = config.get("profile_context", {})
+    if not isinstance(value, dict):
+        raise ValueError("invalid profile context")
+    if bound and value.get("allow_root_auth_fallback") is not False:
+        raise ValueError("Box profiles require explicit narrow authentication policy")
+    return value
+
+
+def root_auth_fallback_allowed(provider_id=None):
+    selected = policy()
+    value = selected.get("allow_root_auth_fallback", True)
+    if not isinstance(value, bool):
+        raise ValueError("invalid root authentication fallback policy")
+    shared = selected.get("share_inference_provider")
+    if shared is None:
+        return value
+    if shared != "openai-codex":
+        raise ValueError("only the pinned openai-codex inference provider may be shared")
+    from hermes_constants import get_hermes_home
+    from utils import load_yaml_file_readonly
+    config = load_yaml_file_readonly(get_hermes_home() / "config.yaml")
+    if (config.get("model") or {}).get("provider") != shared:
+        raise ValueError("shared inference provider differs from the selected model provider")
+    return provider_id == shared
+
+
+def validate_workdir(workdir, *, home=None):
+    required = policy(home).get("required_cwd")
+    if required is None:
+        return
+    root = Path(required)
+    selected = Path(workdir) if workdir else None
+    if (not root.is_absolute() or not root.is_dir() or root.resolve() != root
+            or selected is None or not selected.is_absolute() or not selected.is_dir()
+            or selected.resolve() != selected or not selected.is_relative_to(root)):
+        raise ValueError("selected profile workdir is unavailable or outside its bound workspace")
+
+
+def apply_profile_environment(env):
+    selected = policy()
+    if not selected:
+        return
+    overlay = selected.get("environment", {})
+    prefixes = selected.get("unset_environment_prefixes", [])
+    if (not isinstance(overlay, dict) or not isinstance(prefixes, list)
+            or any(not isinstance(p, str) or not p for p in prefixes)):
+        raise ValueError("invalid profile subprocess environment")
+    for key, value in overlay.items():
+        if (not isinstance(key, str) or not key or "=" in key or "\0" in key
+                or not isinstance(value, str) or "\0" in value
+                or key in ("HOME", "HERMES_HOME", "CODEX_HOME")):
+            raise ValueError("invalid profile environment selector")
+    for key in list(env):
+        if any(key.startswith(prefix) for prefix in prefixes):
+            del env[key]
+    env.update(overlay)
+
+
+def box_context():
+    import json
+    from hermes_constants import get_hermes_home
+    if not policy().get("required_cwd"):
+        return None
+    path = get_hermes_home() / "loom-box-owner.json"
+    if path.is_symlink() or path.stat().st_size > 65536:
+        raise ValueError("profile Box binding unavailable")
+    marker = json.loads(path.read_bytes())
+    if marker.get("retired") is not False:
+        raise ValueError("profile Box binding is retired or unavailable")
+    return {k: marker[k] for k in ("box_id", "profile", "workdir", "context_revision")}
+
+
+def bind_job_context(origin, workdir):
+    context = box_context()
+    if context is None:
+        return origin
+    validate_workdir(workdir)
+    origin = dict(origin or {})
+    origin["loom_box_context"] = context
+    return origin
+
+
+def validate_job_context(job):
+    expected = box_context()
+    if expected is None:
+        return
+    origin = job.get("origin") or {}
+    saved = origin.get("loom_box_context") or origin.get("loom_box_schedule") or origin.get("loom_internal_events") or {}
+    if any(saved.get(k) != v for k, v in expected.items()):
+        raise ValueError("saved job Box/profile context changed")
