    v0-2-slice-10-smoke) cmd_slice_smoke "v0_2_slice_10_watched_root_sync_index.sh" ;;
    v0-2-slice-11-smoke) cmd_slice_smoke "v0_2_slice_11_watched_root_backup.sh" ;;
    v0-2-slice-12-smoke) cmd_slice_smoke "v0_2_slice_12_cli_portal.sh" ;;
