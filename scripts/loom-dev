cmd_v0_4_2_smoke() {
  cmd_v0_4_2_dropzone_smoke
  cmd_slice_smoke "v0_4_1_loom_box_foundation.sh"
  ssh_remote 'loom health --json | jq -e ".ok == true and .data.status == \"ok\"" >/dev/null'
  printf 'loom-dev: v0.4.2 Dropzone acceptance passed\n'
}

