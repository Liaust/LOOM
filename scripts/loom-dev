  local cmd="${1:-}"
  if [[ $# -gt 0 ]]; then
    shift
  fi

  case "$cmd" in
    ssh) cmd_ssh "$@" ;;
    sync) cmd_sync "$@" ;;
    restart) cmd_restart "$@" ;;
    logs) cmd_logs "$@" ;;
    status) cmd_status "$@" ;;
    health) cmd_health "$@" ;;
    health-json) cmd_health_json "$@" ;;
    flake-check) cmd_flake_check "$@" ;;
    rebuild) cmd_rebuild "$@" ;;
    slice-00-smoke) cmd_slice_smoke "slice_00_server_contract.sh" ;;
    slice-01-smoke) cmd_slice_smoke "slice_01_health.sh" ;;
    slice-02-smoke) cmd_slice_smoke "slice_02_core_spine.sh" ;;
