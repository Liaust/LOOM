    slice-18-smoke) cmd_slice_smoke "slice_18_pre_hardware_hardening.sh" ;;
    v0-2-slice-01-smoke) cmd_slice_smoke "v0_2_slice_01_worker_core.sh" ;;
    v0-2-slice-02-smoke) cmd_slice_smoke "v0_2_slice_02_main_maintenance.sh" ;;
    v0-2-slice-03-smoke) cmd_slice_smoke "v0_2_slice_03_backup_integrity.sh" ;;
