fail() {
  printf 'loom-dev: %s\n' "$*" >&2
  exit 1
}

ssh_remote() {
  ssh -o BatchMode=yes "$HOST" "$@"
}

require_safe_remote_dir() {
  case "$REMOTE_DIR" in
    /srv/loom/current) ;;
    *) fail "refusing to sync to non-standard remote dir: $REMOTE_DIR" ;;
  esac
}

cmd_ssh() {
  ssh "$HOST"
}

cmd_sync() {
  require_safe_remote_dir

  ssh_remote "test -d '$REMOTE_DIR' && test -w '$REMOTE_DIR'"

  rsync -az --delete \
    --exclude '.git/' \
    --exclude '.direnv/' \
    --exclude '.DS_Store' \
    --exclude 'result' \
    --exclude 'result-*' \
    --exclude 'node_modules/' \
    --exclude 'tmp/' \
    --exclude '.cache/' \
    "$REPO_ROOT"/ "$HOST:$REMOTE_DIR"/
}

cmd_restart() {
  ssh_remote 'sudo systemctl restart loomd && systemctl is-active loomd'
}

cmd_logs() {
  local arg="${1:-80}"

  if [[ "$arg" == "-f" || "$arg" == "--follow" ]]; then
    ssh "$HOST" 'journalctl -u loomd -f'
  else
    ssh_remote "journalctl -u loomd -n '$arg' --no-pager"
  fi
}

cmd_status() {
  ssh_remote '
    set -e
    printf "host: "
    hostname
    printf "user: "
    whoami
    printf "root: "
    findmnt -n -o SOURCE,FSTYPE /
    printf "nixos: "
    nixos-version
    printf "postgresql: "
    systemctl is-active postgresql
    printf "loomd: "
    systemctl is-active loomd
    printf "loom user: "
    id -un loom
    printf "database: "
    sudo -u loom psql -d loom_main -tAc "SELECT current_user || '"'"':'"'"' || current_database();"
    sudo stat -c "%U:%G %a %n" /srv/loom/current /var/lib/loom /var/lib/loom/object-store /etc/loom
  '
}

cmd_health() {
  ssh_remote 'loom health'
}

cmd_health_json() {
  ssh_remote 'loom health --json'
}

cmd_flake_check() {
  if command -v nix >/dev/null 2>&1; then
    (cd "$REPO_ROOT" && nix flake check --show-trace)
  else
    ssh_remote "cd '$REMOTE_DIR' && nix flake check --no-write-lock-file --show-trace"
  fi
}

cmd_rebuild() {
  ssh_remote "cd '$REMOTE_DIR' && sudo nixos-rebuild switch --flake .#dev-utm --show-trace"
}

cmd_slice_smoke() {
  local slice="$1"
  local script="$SMOKE_DIR/$slice"

  [[ -x "$script" ]] || fail "smoke script is missing or not executable: $script"
  LOOM_DEV_HOST="$HOST" LOOM_DEV_REMOTE_DIR="$REMOTE_DIR" "$script"
}

cmd_smoke() {
  local script

  for script in "$SMOKE_DIR"/slice_*.sh; do
    [[ -x "$script" ]] || fail "smoke script is missing or not executable: $script"
    LOOM_DEV_HOST="$HOST" LOOM_DEV_REMOTE_DIR="$REMOTE_DIR" "$script"
  done
}

cmd_v0_2_smoke() {
  local script

  for script in \
    v0_2_slice_01_worker_core.sh \
    v0_2_slice_02_main_maintenance.sh \
    v0_2_slice_03_backup_integrity.sh \
    v0_2_slice_04_indexing_worker.sh \
    v0_2_slice_05_job_runner.sh \
    v0_2_slice_06_automation_scheduler.sh \
    v0_2_slice_07_direct_events.sh \
    v0_2_slice_08_node_agent_runtime.sh \
    v0_2_slice_09_watched_root_scanner.sh \
    v0_2_slice_10_watched_root_sync_index.sh \
    v0_2_slice_11_watched_root_backup.sh \
    v0_2_slice_12_cli_portal.sh
  do
    cmd_slice_smoke "$script"
  done
}

cmd_v0_2_acceptance() {
  cmd_v0_2_smoke
  cmd_slice_smoke "v0_2_slice_13_hardening.sh"
  printf 'loom-dev: v0.2 acceptance passed\n'
}

cmd_v0_2_1_smoke() {
  local script

  for script in \
    v0_2_1_slice_01_portal_foundation.sh \
    v0_2_1_slice_02_backend_compatibility.sh \
    v0_2_1_slice_03_action_lifecycle.sh \
    v0_2_1_slice_04_worker_index_maintenance_actions.sh \
    v0_2_1_slice_05_portal_styling.sh \
    v0_2_1_slice_06_database_objects.sh \
    v0_2_1_slice_07_action_expansion.sh \
    v0_2_1_slice_08_command_mode.sh \
    v0_2_1_slice_09_portal_hardening.sh \
    v0_2_1_slice_10_portal_scoped_search.sh
  do
    cmd_slice_smoke "$script"
  done
}

